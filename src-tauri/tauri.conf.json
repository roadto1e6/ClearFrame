{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClearFrame",
  "version": "0.2.0",
  "identifier": "com.local.clearframe",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClearFrame · 图片与视频修补",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "backgroundColor": "#101217"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "resources": [
      "tools/ffmpeg.exe"
    ]
  }
}
